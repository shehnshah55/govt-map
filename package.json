{
  "name": "pakistan-gov-graph",
  "version": "0.1.0",
  "private": true,
  "description": "An open, source-cited graph of the Government of Pakistan at every level: federal, provincial, special territories, divisions, districts and local government.",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "validate": "tsx scripts/build-data.ts --check",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "build:single": "npm run data && vite build --mode single",
    "check:build": "tsx scripts/check-build.ts dist/index.html dist-single/index.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run data && tsc --noEmit",
    "audit:coverage": "tsx scripts/audit-coverage.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^4.0.1",
    "d3-geo": "^3.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/cytoscape": "^3.31.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/topojson-client": "^3.1.5",
    "playwright-core": "1.64.1",
    "polygon-clipping": "^0.15.7",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
